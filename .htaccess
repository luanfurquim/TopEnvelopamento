# Top Envelopamento — landing page estática

DirectoryIndex index.html

# Uma URL so. Sem estas regras, http://, https://, www. e sem-www respondem
# 200 na mesma pagina: quatro enderecos para o mesmo conteudo. A canonical
# segura o essencial, mas o 301 e o que resolve — e e o que faz a verificacao
# de propriedade do Search Console cair sempre na mesma variante.
# X-Forwarded-Proto entra porque na HostGator o TLS termina antes do Apache,
# e sem essa condicao o %{HTTPS} nunca marca "on" e o redirect vira laco.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://ppftopenvelopamento.com.br/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://ppftopenvelopamento.com.br/$1 [R=301,L]
</IfModule>

# O ExpiresByType so dispara se o Apache souber derivar o Content-Type da
# extensao. Sem estas linhas, .webp e .woff2 saem sem tipo declarado, a regra
# de cache de 1 ano nunca vale e a segunda visita fica mais lenta — sem que
# nada quebre visualmente, porque o navegador adivinha o formato.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /index.html
